# ============================================================
# Furni — Environment Configuration
# ============================================================
# Copy this file to `.env` (same folder as manage.py) and fill in real
# values. `.env` is already listed in .gitignore, so it will never be
# committed to version control.
#
#   cp .env.example .env
#
# Nothing in this file is required to run the project locally — every
# setting has a safe default (SQLite database, console email backend,
# in-memory cache) so `python manage.py runserver` works out of the box
# with ZERO configuration. Fill these in when you're ready to deploy.


# ------------------------------------------------------------
# Core
# ------------------------------------------------------------
# Generate a real one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-CHANGE-THIS-SECRET-KEY-IN-PRODUCTION-abc123xyz987

# True for local development. MUST be False in production.
DEBUG=True

# Comma-separated list of domains/IPs allowed to serve the site.
# Example for production: ALLOWED_HOSTS=furni.com,www.furni.com
ALLOWED_HOSTS=*


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Leave DB_ENGINE unset (or "sqlite") to keep using the bundled SQLite
# database — perfect for development and small deployments.
# Set DB_ENGINE=postgres for production and fill in the fields below.
# DB_ENGINE=postgres
# DB_NAME=furni
# DB_USER=furni
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432


# ------------------------------------------------------------
# Email / SMTP — THIS IS WHAT ACTUALLY SENDS THE OTP CODES
# ------------------------------------------------------------
# Leave EMAIL_BACKEND unset (or "console") for local development: OTP
# codes and password-reset links are printed to the terminal running
# `manage.py runserver` instead of being emailed — nothing to configure,
# nothing to sign up for, just watch the terminal after registering/logging in.
#
# Set EMAIL_BACKEND=smtp and fill in the fields below to send REAL emails
# (required in production, or any time you want to test real delivery).
#
# --- Example using Gmail ---
# 1. Turn on 2-Step Verification on the Gmail account: https://myaccount.google.com/security
# 2. Create an "App Password": https://myaccount.google.com/apppasswords
#    (choose "Mail" as the app) — use that 16-character password below,
#    NOT the account's normal login password.
#
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=Furni Store <your-address@gmail.com>
#
# --- Other providers work the same way, just change host/port ---
# Outlook/Office365 : smtp.office365.com : 587 (TLS)
# Yahoo             : smtp.mail.yahoo.com : 587 (TLS)
# SendGrid          : smtp.sendgrid.net   : 587 (TLS), EMAIL_HOST_USER=apikey
# Mailgun / Amazon SES / Postmark: use the SMTP credentials they give you
# the same way — same 5 fields, different host/port/user/password.


# ------------------------------------------------------------
# Cache (used for login brute-force protection — 5 failed attempts locks
# a user out for 5 minutes)
# ------------------------------------------------------------
# Leave unset to use Django's in-process LocMemCache — fine for a single
# development server. In production with more than one worker/process,
# set REDIS_URL so the failed-attempt counter is shared correctly.
# REDIS_URL=redis://127.0.0.1:6379/1


# ------------------------------------------------------------
# Site settings
# ------------------------------------------------------------
SITE_NAME=Furni
TIME_ZONE=Africa/Cairo
FREE_SHIPPING_THRESHOLD=300
SHIPPING_COST=25
TAX_RATE=0.0
